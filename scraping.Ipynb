
# ==========================================
# WEB SCRAPING DATASET PARIWISATA NTB
# ==========================================

import os
import re
import json
import time
import requests
import pandas as pd

from bs4 import BeautifulSoup
from urllib.parse import urljoin
from urllib.robotparser import RobotFileParser

# 1. Identitas email kampus
# GANTI dengan email kampus milikmu sendiri
CAMPUS_EMAIL = "EMAIL_KAMPUS_KAMU"

if "@" not in CAMPUS_EMAIL or "KAMU" in CAMPUS_EMAIL:
    raise ValueError("Isi CAMPUS_EMAIL dengan email kampus yang benar.")

# 2. Alamat website
URL = "https://data.ntbprov.go.id/index.php/dataset?publisher=18"
ROBOTS_URL = "https://data.ntbprov.go.id/robots.txt"

# 3. Folder penyimpanan
BASE = "/content/UTS-DAM-Pariwisata-NTB"

RAW = os.path.join(BASE, "data", "raw")
PROCESSED = os.path.join(BASE, "data", "processed")

os.makedirs(RAW, exist_ok=True)
os.makedirs(PROCESSED, exist_ok=True)

# 4. User-Agent
headers = {
    "User-Agent": f"UTS-DAM-Mahasiswa ({CAMPUS_EMAIL})"
}

# 5. Periksa robots.txt
print("Memeriksa robots.txt...")

robots_response = requests.get(
    ROBOTS_URL,
    headers=headers,
    timeout=20
)

robots_response.raise_for_status()

robots_parser = RobotFileParser()
robots_parser.set_url(ROBOTS_URL)
robots_parser.parse(robots_response.text.splitlines())

allowed = robots_parser.can_fetch(
    headers["User-Agent"],
    URL
)

print("Izin scraping:", allowed)

if not allowed:
    raise PermissionError(
        "Scraping tidak diizinkan oleh robots.txt."
    )

# 6. Jeda sebelum request halaman
time.sleep(2)

# 7. Mengambil halaman website
response = requests.get(
    URL,
    headers=headers,
    timeout=20
)

response.raise_for_status()

print("Status HTTP:", response.status_code)

# 8. Simpan HTML asli tanpa perubahan
raw_html_path = os.path.join(
    RAW,
    "hasil_scraping_ntb_raw.html"
)

with open(raw_html_path, "w", encoding="utf-8") as file:
    file.write(response.text)

# 9. Parsing HTML dengan BeautifulSoup
soup = BeautifulSoup(response.text, "html.parser")

records = []

for a in soup.find_all("a", href=True):

    title = a.get_text(" ", strip=True)

    # Ambil tautan yang tampak seperti judul dataset
    if not title or len(title) < 12:
        continue

    if title.lower() in [
        "dataset", "organisasi", "visualisasi",
        "artikel", "publikasi"
    ]:
        continue

    # Cari informasi dari elemen induk
    parent = a

    for _ in range(5):
        if parent.parent:
            parent = parent.parent

    card_text = parent.get_text(" ", strip=True)

    if "Dinas Pariwisata" not in card_text:
        continue

    records.append({
        "judul_dataset": title,
        "url_dataset": urljoin(URL, a["href"]),
        "informasi": card_text
    })

# 10. Hilangkan duplikasi URL
df_scraping = pd.DataFrame(records)

if df_scraping.empty:
    raise ValueError(
        "Tidak ditemukan data dataset. "
        "Periksa struktur HTML halaman."
    )

df_scraping = df_scraping.drop_duplicates(
    subset=["url_dataset"]
).reset_index(drop=True)

# 11. Simpan hasil scraping dalam JSON
json_raw_path = os.path.join(
    RAW,
    "hasil_scraping_ntb_raw.json"
)

df_scraping.to_json(
    json_raw_path,
    orient="records",
    indent=4,
    force_ascii=False
)

# 12. Simpan hasil dalam tabel CSV
csv_path = os.path.join(
    PROCESSED,
    "hasil_scraping_ntb_bersih.csv"
)

df_scraping.to_csv(
    csv_path,
    index=False,
    encoding="utf-8-sig"
)

# 13. Simpan JSON berbentuk records
json_path = os.path.join(
    PROCESSED,
    "hasil_scraping_ntb_bersih.json"
)

df_scraping.to_json(
    json_path,
    orient="records",
    indent=4,
    force_ascii=False
)

# 14. Simpan HTML berbentuk tabel
html_path = os.path.join(
    PROCESSED,
    "hasil_scraping_ntb_bersih.html"
)

table_html = df_scraping.to_html(
    index=False,
    border=1,
    justify="left"
)

with open(html_path, "w", encoding="utf-8") as file:
    file.write(
        "<html><head><meta charset='UTF-8'>"
        "<title>Hasil Scraping Pariwisata NTB</title>"
        "</head><body>"
        "<h2>Daftar Dataset Pariwisata NTB</h2>"
        + table_html +
        "</body></html>"
    )

# 15. Tampilkan hasil
print("Jumlah data hasil scraping:", len(df_scraping))
display(df_scraping)

print("\nFile berhasil disimpan:")
print(raw_html_path)
print(json_raw_path)
print(csv_path)
print(json_path)
print(html_path)
